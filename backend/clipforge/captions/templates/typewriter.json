{
  "id": "typewriter",
  "label": "Typewriter",
  "description": "Monospace text typed out on a dark card.",
  "font": {
    "file": "JetBrainsMono.ttf",
    "family": "JetBrains Mono",
    "weight": 600,
    "italic": false
  },
  "size": 0.05,
  "line_height": 1.3,
  "fill": "#E8FFE8",
  "stroke": {
    "color": "#000000",
    "width": 0.0
  },
  "shadow": {
    "color": "#000000",
    "blur": 0.0,
    "dy": 0.0,
    "opacity": 0.0
  },
  "box": {
    "color": "#0B0F0B",
    "opacity": 0.78,
    "radius": 0.008,
    "pad_x": 0.03,
    "pad_y": 0.018
  },
  "active": {
    "mode": "color",
    "color": "#7CFF9E"
  },
  "motion": {
    "kind": "typewriter",
    "ms": 300,
    "easing": "linear"
  },
  "chunking": {
    "max_words": 6,
    "max_chars_per_line": 24,
    "target_wps": 3.0
  },
  "hook": {
    "size": 0.052,
    "font": {
      "file": "JetBrainsMono.ttf",
      "family": "JetBrains Mono",
      "weight": 700,
      "italic": false
    },
    "fill": "#7CFF9E",
    "box": {
      "color": "#0B0F0B",
      "opacity": 0.85,
      "radius": 0.008,
      "pad_x": 0.03,
      "pad_y": 0.016
    }
  }
}
