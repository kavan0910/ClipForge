{
  "id": "heavy-outline",
  "label": "Heavy outline",
  "description": "Condensed caps with a thick black outline.",
  "font": {
    "file": "BebasNeue-Regular.ttf",
    "family": "Bebas Neue",
    "weight": 400,
    "italic": false
  },
  "size": 0.105,
  "case": "upper",
  "tracking": 0.02,
  "line_height": 1.02,
  "fill": "#FFFFFF",
  "stroke": {
    "color": "#000000",
    "width": 0.016
  },
  "shadow": {
    "color": "#000000",
    "blur": 0.0,
    "dy": 0.008,
    "opacity": 0.9
  },
  "active": {
    "mode": "color",
    "color": "#FFD400"
  },
  "emphasis": {
    "color": "#FF5A36"
  },
  "motion": {
    "kind": "pop",
    "ms": 150,
    "easing": "back_out"
  },
  "chunking": {
    "max_words": 3,
    "max_chars_per_line": 13,
    "target_wps": 2.2
  },
  "emoji": true,
  "hook": {
    "size": 0.1,
    "case": "upper",
    "fill": "#FFD400",
    "stroke": {
      "color": "#000000",
      "width": 0.012
    },
    "box": null
  }
}
