ANTHROPIC_API_KEY=
CLIPFORGE_SCAN_MODEL=claude-haiku-4-5-20251001
CLIPFORGE_CURATE_MODEL=claude-sonnet-5
MAX_JOB_COST_USD=1.00
# Optional, for speaker diarization (Hugging Face token with pyannote terms accepted)
HF_TOKEN=
# auto | faster-whisper | mlx-whisper
ASR_BACKEND=auto
# large-v3-turbo (default, see ADR-001) or large-v3
ASR_MODEL=large-v3-turbo
MAX_SOURCE_HEIGHT=1080
# Optional, e.g. chrome (uses that browser's login for restricted videos you own)
YTDLP_COOKIES_FROM_BROWSER=
DATA_DIR=~/Clipforge
RENDER_WORKERS=2
