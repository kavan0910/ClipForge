ANTHROPIC_API_KEY=
CLIPFORGE_SCAN_MODEL=claude-haiku-4-5-20251001
CLIPFORGE_CURATE_MODEL=claude-sonnet-5
# Models used by the Max quality preset
CLIPFORGE_MAX_SCAN_MODEL=claude-sonnet-5
CLIPFORGE_MAX_CURATE_MODEL=claude-opus-5
MAX_JOB_COST_USD=1.00
# Optional, for speaker diarization (Hugging Face token with pyannote terms accepted)
HF_TOKEN=
# auto | faster-whisper | mlx-whisper
ASR_BACKEND=auto
# large-v3-turbo (default, see ADR-001) or large-v3
ASR_MODEL=large-v3-turbo
# Used automatically when the spoken language is not English (turbo is weaker there). "same" disables the rule.
ASR_MODEL_NON_ENGLISH=large-v3

# Optional, e.g. chrome (uses that browser's login for restricted videos you own)
YTDLP_COOKIES_FROM_BROWSER=
DATA_DIR=~/Clipforge
RENDER_WORKERS=2

# YouTube publishing (optional): a "Desktop app" OAuth client from Google Cloud Console
# (enable YouTube Data API v3). See README "Publishing".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Independent steps (proxy, shot/motion analysis, laughter detection, speaker identification) run beside transcription.
# None of them uses another step's output, so results are identical. Set to false to run strictly one step at a time.
PIPELINE_PARALLEL=true

# Mixed-language videos: english_first transcribes only the English sections and clips only from them; auto transcribes everything.
LANGUAGE_POLICY=english_first
# fit = whole frame at full width over a blurred background (sharpest); smart = crop to a vertical frame and follow the speaker.
DEFAULT_LAYOUT=fit

# Small pushes on emphasised words and a slow drift inside each take (fit layout). off = a locked picture.
RENDER_PUNCH_IN=auto
